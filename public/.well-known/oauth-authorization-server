{
  "issuer": "https://www.mel.iq",
  "authorization_endpoint": "https://www.mel.iq/login",
  "token_endpoint": "https://www.mel.iq/api/oauth2/token",
  "registration_endpoint": "https://www.mel.iq/api/agent/identity",
  "revocation_endpoint": "https://www.mel.iq/api/oauth2/revoke",
  "jwks_uri": "https://www.mel.iq/.well-known/jwks.json",
  "grant_types_supported": [
    "urn:ietf:params:oauth:grant-type:jwt-bearer",
    "urn:workos:agent-auth:grant-type:claim",
    "refresh_token",
    "urn:mel:params:oauth:grant-type:phone_otp"
  ],
  "response_types_supported": ["token"],
  "token_endpoint_auth_methods_supported": ["none"],
  "scopes_supported": [
    "openid",
    "profile",
    "stores:read",
    "stores:write",
    "orders:read",
    "orders:write",
    "agent:preclaim",
    "agent:full"
  ],
  "service_documentation": "https://www.mel.iq/auth.md",
  "ui_locales_supported": ["ar", "en"],
  "agent_auth": {
    "skill": "https://www.mel.iq/auth.md",
    "register_uri": "https://www.mel.iq/api/agent/identity",
    "identity_endpoint": "https://www.mel.iq/api/agent/identity",
    "claim_endpoint": "https://www.mel.iq/api/agent/identity/claim",
    "events_endpoint": "https://www.mel.iq/api/agent/event/notify",
    "identity_types_supported": [
      "anonymous",
      "identity_assertion",
      "service_auth"
    ],
    "anonymous": {
      "credential_types_supported": ["bearer"],
      "claim_uri": "https://www.mel.iq/api/agent/identity/claim"
    },
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag",
        "verified_email"
      ],
      "credential_types_supported": ["bearer"],
      "claim_uri": "https://www.mel.iq/api/agent/identity/claim"
    },
    "service_auth": {
      "credential_types_supported": ["bearer"],
      "claim_uri": "https://www.mel.iq/api/agent/identity/claim"
    },
    "events_supported": [
      "https://schemas.workos.com/events/agent/auth/identity/assertion/revoked",
      "credential_revoked"
    ],
    "revocation_uri": "https://www.mel.iq/api/oauth2/revoke"
  }
}
