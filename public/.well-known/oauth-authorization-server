{
  "issuer": "https://www.mel.iq",
  "authorization_endpoint": "https://www.mel.iq/login",
  "token_endpoint": "https://api.mel.iq/api/v1/auth/verify",
  "registration_endpoint": "https://www.mel.iq/checkout",
  "revocation_endpoint": "https://api.mel.iq/api/v1/auth/logout",
  "jwks_uri": "https://www.mel.iq/.well-known/jwks.json",
  "grant_types_supported": [
    "urn:ietf:params:oauth:grant-type:device_code",
    "refresh_token",
    "urn:mel:params:oauth:grant-type:phone_otp"
  ],
  "response_types_supported": ["token"],
  "token_endpoint_auth_methods_supported": ["none"],
  "scopes_supported": [
    "openid",
    "profile",
    "stores:read",
    "stores:write",
    "orders:read",
    "orders:write"
  ],
  "service_documentation": "https://www.mel.iq/auth.md",
  "ui_locales_supported": ["ar", "en"],
  "agent_auth": {
    "skill": "https://www.mel.iq/auth.md",
    "register_uri": "https://www.mel.iq/checkout",
    "identity_types_supported": ["anonymous", "identity_assertion"],
    "anonymous": {
      "credential_types_supported": ["bearer"],
      "claim_uri": "https://www.mel.iq/checkout"
    },
    "identity_assertion": {
      "assertion_types_supported": ["verified_email", "phone_otp"],
      "credential_types_supported": ["bearer"],
      "claim_uri": "https://api.mel.iq/api/v1/auth/verify"
    },
    "events_supported": ["credential_revoked"],
    "revocation_uri": "https://api.mel.iq/api/v1/auth/logout"
  }
}
